<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Brigade Tree View -->
    <record id="su_brigade_view_tree" model="ir.ui.view">
        <field name="name">su.brigade.tree</field>
        <field name="model">su.brigade</field>
        <field name="arch" type="xml">
            <tree string="Бригады">
                <field name="name"/>
                <field name="foreman_id" widget="many2one_avatar_user"/>
                <field name="specialty"/>
                <field name="member_count" string="Членов"/>
                <field name="active_task_count" string="Активных задач"/>
                <field name="member_ids" widget="many2many_tags"
                       options="{'color_field': 'color'}" optional="hide"/>
            </tree>
        </field>
    </record>

    <!-- Brigade Form View -->
    <record id="su_brigade_view_form" model="ir.ui.view">
        <field name="name">su.brigade.form</field>
        <field name="model">su.brigade</field>
        <field name="arch" type="xml">
            <form string="Бригада">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button class="oe_stat_button" icon="fa-tasks"
                                type="object" name="action_view_tasks">
                            <field name="active_task_count" widget="statinfo"
                                   string="Активных задач"/>
                        </button>
                        <button class="oe_stat_button" icon="fa-users"
                                type="object" name="action_view_tasks">
                            <field name="member_count" widget="statinfo"
                                   string="Членов"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Название бригады"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="foreman_id"/>
                            <field name="specialty"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group string="Члены бригады">
                        <field name="member_ids" widget="many2many_tags" nolabel="1"/>
                    </group>
                    <notebook>
                        <page string="Задачи" name="tasks">
                            <field name="task_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="project_id"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-info="state == 'in_progress'"
                                           decoration-warning="state == 'review'"
                                           decoration-muted="state == 'cancelled'"/>
                                    <field name="deadline"/>
                                    <field name="progress" widget="progressbar"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="su_brigade_action" model="ir.actions.act_window">
        <field name="name">Бригады</field>
        <field name="res_model">su.brigade</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Создайте первую бригаду
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="su_brigade_menu"
              name="Бригады"
              parent="su_project.su_main_menu"
              action="su_brigade_action"
              sequence="35"/>

</odoo>
