<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Subscription Tree View -->
    <record id="su_subscription_view_tree" model="ir.ui.view">
        <field name="name">su.subscription.tree</field>
        <field name="model">su.subscription</field>
        <field name="arch" type="xml">
            <tree string="Подписки"
                  decoration-success="status == 'active'"
                  decoration-warning="status == 'trial'"
                  decoration-danger="status == 'past_due'"
                  decoration-muted="status == 'cancelled'">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="plan"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-warning="status == 'trial'"
                       decoration-danger="status == 'past_due'"/>
                <field name="plan_amount" widget="monetary"/>
                <field name="trial_end"/>
                <field name="next_payment_date"/>
                <field name="ai_estimates_used"/>
                <field name="max_ai_estimates"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Subscription Form View -->
    <record id="su_subscription_view_form" model="ir.ui.view">
        <field name="name">su.subscription.form</field>
        <field name="model">su.subscription</field>
        <field name="arch" type="xml">
            <form string="Подписка">
                <header>
                    <button name="action_activate" type="object"
                            string="Активировать" class="oe_highlight"
                            invisible="status not in ('trial', 'past_due')"/>
                    <button name="action_cancel" type="object"
                            string="Отменить"
                            invisible="status in ('cancelled',)"
                            confirm="Вы уверены, что хотите отменить подписку?"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="trial,active"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Основное">
                            <field name="partner_id"/>
                            <field name="plan"/>
                            <field name="plan_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group string="Лимиты">
                            <field name="max_projects"/>
                            <field name="max_ai_estimates"/>
                            <field name="ai_estimates_used"/>
                        </group>
                    </group>
                    <group>
                        <group string="Даты">
                            <field name="trial_end"/>
                            <field name="last_payment_date"/>
                            <field name="next_payment_date"/>
                        </group>
                        <group string="ЮKassa">
                            <field name="yukassa_customer_id"/>
                            <field name="yukassa_payment_method_id"/>
                            <field name="yukassa_subscription_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="su_subscription_action" model="ir.actions.act_window">
        <field name="name">Подписки</field>
        <field name="res_model">su.subscription</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Нет активных подписок
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="su_billing_menu_root"
              name="Биллинг"
              parent="su_project.su_main_menu"
              sequence="90"/>

    <menuitem id="su_subscription_menu"
              name="Подписки"
              parent="su_billing_menu_root"
              action="su_subscription_action"
              sequence="10"/>

</odoo>
