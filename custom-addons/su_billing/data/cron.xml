<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <!-- Cron: Check expired trials daily at 03:00 UTC -->
        <record id="ir_cron_check_trial_expirations" model="ir.cron">
            <field name="name">СтройУправ: Проверка истекших trial-подписок</field>
            <field name="model_id" ref="model_su_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_trial_expirations()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="doall">False</field>
        </record>

        <!-- Cron: Send trial reminder emails daily at 10:00 UTC -->
        <record id="ir_cron_send_trial_reminders" model="ir.cron">
            <field name="name">СтройУправ: Напоминания об окончании trial</field>
            <field name="model_id" ref="model_su_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_send_trial_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
            <field name="doall">False</field>
        </record>

    </data>
</odoo>
