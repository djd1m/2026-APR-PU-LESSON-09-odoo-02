<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Estimate Tree View -->
    <record id="su_estimate_view_tree" model="ir.ui.view">
        <field name="name">su.estimate.tree</field>
        <field name="model">su.estimate</field>
        <field name="arch" type="xml">
            <tree string="Сметы">
                <field name="name"/>
                <field name="project_id"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'confirmed'"
                       decoration-muted="state == 'archived'"/>
                <field name="ai_generated" widget="boolean"/>
                <field name="total_amount" widget="monetary" sum="Итого"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Estimate Form View -->
    <record id="su_estimate_view_form" model="ir.ui.view">
        <field name="name">su.estimate.form</field>
        <field name="model">su.estimate</field>
        <field name="arch" type="xml">
            <form string="Смета">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,confirmed"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Название сметы"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="ai_generated"/>
                        </group>
                        <group>
                            <field name="total_amount" widget="monetary"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <page string="Позиции сметы" name="items">
                            <field name="item_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="gesn_code"/>
                                    <field name="name"/>
                                    <field name="unit"/>
                                    <field name="quantity"/>
                                    <field name="unit_price" widget="monetary"/>
                                    <field name="amount" widget="monetary" sum="Итого"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="su_estimate_action" model="ir.actions.act_window">
        <field name="name">Сметы</field>
        <field name="res_model">su.estimate</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Создайте первую смету
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="su_estimate_menu"
              name="Сметы"
              parent="su_project.su_main_menu"
              action="su_estimate_action"
              sequence="20"/>

</odoo>
