<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <!-- Module category -->
        <record id="module_category_construction" model="ir.module.category">
            <field name="name">СтройУправ</field>
            <field name="description">Управление строительными объектами</field>
            <field name="sequence">100</field>
        </record>

        <!-- Foreman (Прораб) — base access to own objects/tasks/photos -->
        <record id="group_su_foreman" model="res.groups">
            <field name="name">Прораб</field>
            <field name="category_id" ref="module_category_construction"/>
            <field name="comment">Доступ к задачам и фото своих объектов</field>
        </record>

        <!-- Manager (Руководитель) — full access to projects, tasks, estimates -->
        <record id="group_su_manager" model="res.groups">
            <field name="name">Руководитель</field>
            <field name="category_id" ref="module_category_construction"/>
            <field name="implied_ids" eval="[(4, ref('group_su_foreman'))]"/>
            <field name="comment">Управление объектами, задачами, сметами, бригадами</field>
        </record>

        <!-- Admin — full system access including billing and settings -->
        <record id="group_su_admin" model="res.groups">
            <field name="name">Администратор</field>
            <field name="category_id" ref="module_category_construction"/>
            <field name="implied_ids" eval="[(4, ref('group_su_manager'))]"/>
            <field name="comment">Полный доступ, включая настройки и биллинг</field>
        </record>

        <!-- Client (Заказчик) — read-only portal access -->
        <record id="group_su_client" model="res.groups">
            <field name="name">Заказчик</field>
            <field name="category_id" ref="module_category_construction"/>
            <field name="comment">Просмотр объектов, прогресса, фотоотчётов (read-only)</field>
        </record>

    </data>
</odoo>
