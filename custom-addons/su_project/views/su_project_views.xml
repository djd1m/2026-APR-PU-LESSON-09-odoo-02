<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Tree View -->
    <record id="su_project_view_tree" model="ir.ui.view">
        <field name="name">su.project.tree</field>
        <field name="model">su.project</field>
        <field name="arch" type="xml">
            <tree string="Объекты"
                  decoration-success="state == 'done'"
                  decoration-warning="state == 'paused'"
                  decoration-info="state == 'active'">
                <field name="name"/>
                <field name="address"/>
                <field name="project_type"/>
                <field name="state" widget="badge"
                       decoration-success="state == 'done'"
                       decoration-warning="state == 'paused'"
                       decoration-info="state == 'active'"/>
                <field name="area_sqm"/>
                <field name="budget_planned" widget="monetary"/>
                <field name="budget_actual" widget="monetary"/>
                <field name="progress" widget="progressbar"/>
                <field name="manager_id"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="currency_id" column_invisible="True"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="su_project_view_form" model="ir.ui.view">
        <field name="name">su.project.form</field>
        <field name="model">su.project</field>
        <field name="arch" type="xml">
            <form string="Строительный объект">
                <header>
                    <field name="state" widget="statusbar"
                           statusbar_visible="draft,active,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Название объекта"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="address"/>
                            <field name="project_type"/>
                            <field name="area_sqm"/>
                            <field name="manager_id"/>
                        </group>
                        <group>
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="budget_planned" widget="monetary"/>
                            <field name="budget_actual" widget="monetary"/>
                            <field name="progress" widget="progressbar"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Задачи" name="tasks">
                            <field name="task_ids"/>
                        </page>
                        <page string="Сметы" name="estimates">
                            <field name="estimate_ids"/>
                        </page>
                        <page string="Фото" name="photos">
                            <field name="photo_ids"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Kanban View -->
    <record id="su_project_view_kanban" model="ir.ui.view">
        <field name="name">su.project.kanban</field>
        <field name="model">su.project</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="state"/>
                <field name="progress"/>
                <field name="budget_planned"/>
                <field name="budget_actual"/>
                <field name="manager_id"/>
                <field name="currency_id"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="progress" widget="progressbar"/>
                                    <div>
                                        <span>План: </span>
                                        <field name="budget_planned" widget="monetary"/>
                                    </div>
                                    <div>
                                        <span>Факт: </span>
                                        <field name="budget_actual" widget="monetary"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="manager_id" widget="many2one_avatar_user"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Action -->
    <record id="su_project_action" model="ir.actions.act_window">
        <field name="name">Объекты</field>
        <field name="res_model">su.project</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Создайте первый строительный объект
            </p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="su_main_menu"
              name="СтройУправ"
              web_icon="su_project,static/description/icon.png"
              sequence="100"/>

    <menuitem id="su_project_menu"
              name="Объекты"
              parent="su_main_menu"
              action="su_project_action"
              sequence="10"/>

</odoo>
